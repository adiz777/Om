# Copy to .env locally. Never commit real credentials.
OM_SENTINEL_HOST=127.0.0.1
OM_SENTINEL_PORT=8787
OM_SENTINEL_API_KEY=replace-with-a-long-random-secret
OM_SENTINEL_DB_PATH=
# AI options: ollama (local-first), freellmapi, openai-compatible, or off
OM_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional OpenAI-compatible FreeLLMAPI gateway
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
# Optional other OpenAI-compatible provider
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=auto
# Optional NVD API key improves rate limits; not required.
NVD_API_KEY=
