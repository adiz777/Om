# Copy to .env locally. Never commit real credentials.
OM_SENTINEL_HOST=127.0.0.1
OM_SENTINEL_PORT=8787
OM_SENTINEL_API_KEY=replace-with-a-long-random-secret
# Optional OpenAI-compatible FreeLLMAPI gateway (e.g. http://127.0.0.1:3001/v1)
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
# Optional NVD API key improves rate limits; not required.
NVD_API_KEY=
